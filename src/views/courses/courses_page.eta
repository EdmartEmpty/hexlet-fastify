<% layout("../layouts/page") %>
 <form role="form" method="GET" action="/courses">
  <input type="search" name="term" value="<%= it.term ?? '' %>" />
  <input type="submit" value="search" />
</form>
 <div>
     <table>
        <tr>
          <th>Имя статьи</th>
          <th>Текст</th>
        </tr>
        <% it.coursesStorage.forEach((course) => {%>
        <tr>
          <td><%= course.title ?? '' %></td>
          <td><%= course.text ?? '' %></td>
          <td> <a href='<%= it.route('cours',{id: course.id})%>'><%= course.id%></a></td>
        </tr>
        <% }) %>
     </table>
     <a href='<%= it.route('create_articul') %>'>Создать статью</a>
     </div>
     
    